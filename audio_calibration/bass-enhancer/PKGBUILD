# Maintainer: Michael de By (for the Omarchy speaker calibrator plugin)
# Upstream: bankstown by James Calligeros, https://github.com/chadmed/bankstown, MIT
#
# The Deep bass add-on for the Omarchy speaker calibrator: bankstown, built
# from one fixed upstream revision.  The archive checksum was generated by
# makepkg from that commit.
#
# This file lives in the plugin so that what is built is what was reviewed
# with the plugin.  The source is named by the full hash of one commit and by
# the checksum of that commit's archive; git and makepkg refuse anything else,
# and cargo builds with the dependency set frozen to that commit's Cargo.lock.
# Nothing is looked up in the AUR.  The AUR carries the same upstream release
# as bankstown 1.1.0-2; this build's release number sits above it so that an
# AUR helper does not offer to replace a reviewed build with an unpinned one.
pkgname=bankstown
pkgver=1.1.0
pkgrel=3
pkgdesc="Psychoacoustic bass enhancement LV2 plugin, pinned build for the Omarchy speaker calibrator"
url="https://github.com/chadmed/bankstown"
arch=('x86_64')
license=('MIT')
depends=('lv2')
makedepends=('cargo' 'git')
# Rust decides its own optimisation and debug settings from Cargo.toml.
options=('!debug' '!lto')
_commit=e9829c9bccf5ed73768135c0ddd506f5a6690f9e
source=("${pkgname}::git+https://github.com/chadmed/bankstown.git#commit=${_commit}")
sha256sums=('292ec56b0f8b7f285ac5355eed68533c684a2f3e618cd874f244f8924adac049')

prepare() {
  cd "$pkgname"
  # The fragment above already selected this commit; refuse anything else
  # before a single dependency is fetched.
  [ "$(git rev-parse 'HEAD^{commit}')" = "$_commit" ]
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$pkgname"
  cargo build --frozen --release
}

package() {
  cd "$pkgname"
  make DESTDIR="$pkgdir" LIBDIR=/usr/lib install
  install -Dm0644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
}
